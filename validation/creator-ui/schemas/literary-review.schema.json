{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "findings", "extendedCraft"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "creator-literary-review.v1" },
    "findings": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dimension",
          "severity",
          "evidenceQuote",
          "expected",
          "observed",
          "readerImpact",
          "diagnosis",
          "repairDirection",
          "confidence"
        ],
        "properties": {
          "dimension": {
            "type": "string",
            "enum": [
              "continuity",
              "tension",
              "information_control",
              "character_agency",
              "voice",
              "freshness",
              "genre_fulfillment",
              "repetition",
              "exposition",
              "scene_detail",
              "pacing"
            ]
          },
          "severity": { "type": "string", "enum": ["hard_block", "revision_candidate", "taste_note", "preserve"] },
          "evidenceQuote": { "type": "string", "minLength": 2, "maxLength": 180 },
          "expected": { "type": "string", "minLength": 8, "maxLength": 240 },
          "observed": { "type": "string", "minLength": 8, "maxLength": 240 },
          "readerImpact": { "type": "string", "minLength": 8, "maxLength": 240 },
          "diagnosis": { "type": "string", "minLength": 8, "maxLength": 240 },
          "repairDirection": { "type": "string", "minLength": 8, "maxLength": 240 },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] }
        }
      }
    },
    "extendedCraft": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["requestedLensIds", "findings"],
          "properties": {
            "requestedLensIds": {
              "type": "array",
              "maxItems": 2,
              "items": {
                "type": "string",
                "enum": ["pov_focalization", "dialogue_subtext", "prose_rhythm", "ending_payoff"]
              }
            },
            "findings": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "lensId",
                  "severity",
                  "evidenceQuote",
                  "diagnosis",
                  "readerEffectHypothesis",
                  "authorTradeoff",
                  "smallestExperiment",
                  "mappedExistingDimensions",
                  "confidence"
                ],
                "properties": {
                  "lensId": {
                    "type": "string",
                    "enum": ["pov_focalization", "dialogue_subtext", "prose_rhythm", "ending_payoff"]
                  },
                  "severity": { "type": "string", "enum": ["revision_candidate", "taste_note", "preserve"] },
                  "evidenceQuote": { "type": "string", "minLength": 2, "maxLength": 180 },
                  "diagnosis": { "type": "string", "minLength": 8, "maxLength": 240 },
                  "readerEffectHypothesis": { "type": "string", "minLength": 8, "maxLength": 240 },
                  "authorTradeoff": { "type": "string", "minLength": 8, "maxLength": 240 },
                  "smallestExperiment": { "type": "string", "minLength": 8, "maxLength": 240 },
                  "mappedExistingDimensions": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 3,
                    "items": {
                      "type": "string",
                      "enum": [
                        "continuity",
                        "tension",
                        "information_control",
                        "character_agency",
                        "voice",
                        "freshness",
                        "genre_fulfillment",
                        "repetition",
                        "exposition",
                        "scene_detail",
                        "pacing"
                      ]
                    }
                  },
                  "confidence": { "type": "string", "enum": ["high", "medium", "low"] }
                }
              }
            }
          }
        }
      ]
    }
  }
}
