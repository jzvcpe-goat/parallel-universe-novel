{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "provider",
    "simulationRunId",
    "scenarioSummary",
    "evidence",
    "characterCardProposals",
    "settingAssetProposals",
    "warnings"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "character-simulation.v1" },
    "requestId": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "const": "mirofish" },
    "simulationRunId": { "type": "string", "minLength": 1 },
    "scenarioSummary": { "type": "string", "minLength": 8, "maxLength": 1000 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sourceArtifact", "round", "actorIds", "quote", "summary"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "sourceArtifact": { "type": "string", "enum": ["interviews", "actions", "timeline", "report"] },
          "round": { "type": ["integer", "null"], "minimum": 0 },
          "actorIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "quote": { "type": "string", "minLength": 2, "maxLength": 500 },
          "summary": { "type": "string", "minLength": 2, "maxLength": 500 }
        }
      }
    },
    "characterCardProposals": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "characterId", "title", "summary", "narrativeFunction", "arc", "stateChanges", "evidenceIds", "confidence", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "characterId": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 2, "maxLength": 80 },
          "summary": { "type": "string", "minLength": 8, "maxLength": 800 },
          "narrativeFunction": { "type": "string", "minLength": 4, "maxLength": 300 },
          "arc": {
            "type": "object",
            "additionalProperties": false,
            "required": ["desire", "fear", "wound", "defense", "relationshipPressure", "growthOpportunity", "falseBelief", "costOfChoice"],
            "properties": {
              "desire": { "type": "string", "maxLength": 300 },
              "fear": { "type": "string", "maxLength": 300 },
              "wound": { "type": "string", "maxLength": 300 },
              "defense": { "type": "string", "maxLength": 300 },
              "relationshipPressure": { "type": "string", "maxLength": 300 },
              "growthOpportunity": { "type": "string", "maxLength": 300 },
              "falseBelief": { "type": "string", "maxLength": 300 },
              "costOfChoice": { "type": "string", "maxLength": 300 }
            }
          },
          "stateChanges": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["dimension", "before", "after", "reason", "evidenceIds"],
              "properties": {
                "dimension": {
                  "type": "string",
                  "enum": ["location", "timePosition", "physicalCondition", "emotionalState", "dominantDesire", "immediateGoal", "currentIntent", "fear", "woundTrigger", "defenseStrategy", "beliefs", "falseBeliefs", "knowledge", "secrets", "resources", "capabilities", "limitations", "relationshipStances", "trust", "obligations", "recentChoice", "paidCost"]
                },
                "before": { "type": ["string", "null"], "maxLength": 500 },
                "after": { "type": "string", "minLength": 1, "maxLength": 500 },
                "reason": { "type": "string", "minLength": 4, "maxLength": 500 },
                "evidenceIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
              }
            }
          },
          "evidenceIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "status": { "type": "string", "const": "proposed" }
        }
      }
    },
    "settingAssetProposals": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "title", "summary", "detail", "evidenceIds", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["location", "faction", "item", "rule", "timeline"] },
          "title": { "type": "string", "minLength": 2, "maxLength": 80 },
          "summary": { "type": "string", "minLength": 8, "maxLength": 800 },
          "detail": { "type": "string", "minLength": 8, "maxLength": 2000 },
          "evidenceIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "status": { "type": "string", "const": "proposed" }
        }
      }
    },
    "warnings": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
  }
}
