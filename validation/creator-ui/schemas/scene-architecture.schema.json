{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sceneObjective",
    "mechanismSignature",
    "causalChain",
    "informationBoundary",
    "recallObligations",
    "characterPressure",
    "repetitionAvoidance",
    "sensoryAnchors",
    "endingObligation"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "creator-scene-architecture.v1"
    },
    "sceneObjective": {
      "type": "string",
      "minLength": 8,
      "maxLength": 240
    },
    "mechanismSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pressureSource", "conflictEngine", "agencyPattern", "costPattern", "endingPattern", "differentiationEvidence"],
      "properties": {
        "pressureSource": { "type": "string", "enum": ["environment", "opponent", "institution", "relationship", "body", "time", "resource", "information"] },
        "conflictEngine": { "type": "string", "enum": ["rescue", "pursuit", "negotiation", "infiltration", "escape", "investigation", "combat", "survival", "sacrifice", "revelation"] },
        "agencyPattern": { "type": "string", "enum": ["command", "refusal", "concealment", "sacrifice", "bargain", "delegation", "improvisation", "endurance", "pursuit", "withdrawal"] },
        "costPattern": { "type": "string", "enum": ["evidence_loss", "injury", "trust_loss", "resource_loss", "time_loss", "exposure", "position_loss", "obligation", "opportunity_loss", "separation"] },
        "endingPattern": { "type": "string", "enum": ["consequence_arrives", "irreversible_loss", "relationship_shift", "opponent_gain", "location_shift", "promise_advanced", "question_opened", "temporary_relief", "capability_change"] },
        "differentiationEvidence": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": { "type": "string", "minLength": 8, "maxLength": 220 }
        }
      }
    },
    "causalChain": {
      "type": "array",
      "minItems": 4,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "purpose",
          "action",
          "resistance",
          "choice",
          "consequence",
          "informationChange"
        ],
        "properties": {
          "order": { "type": "integer", "minimum": 1, "maximum": 7 },
          "purpose": { "type": "string", "minLength": 4, "maxLength": 100 },
          "action": { "type": "string", "minLength": 8, "maxLength": 220 },
          "resistance": { "type": "string", "minLength": 8, "maxLength": 220 },
          "choice": { "type": "string", "minLength": 8, "maxLength": 220 },
          "consequence": { "type": "string", "minLength": 8, "maxLength": 220 },
          "informationChange": {
            "type": ["string", "null"],
            "maxLength": 220
          }
        }
      }
    },
    "informationBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observableEvidence", "allowedInference", "withheldInference", "deliveryMode"],
      "properties": {
        "observableEvidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "type": "string", "minLength": 8, "maxLength": 180 }
        },
        "allowedInference": { "type": "string", "minLength": 8, "maxLength": 220 },
        "withheldInference": { "type": "string", "minLength": 8, "maxLength": 220 },
        "deliveryMode": {
          "type": "string",
          "enum": ["action_first", "dialogue_reaction", "environmental", "mixed"]
        }
      }
    },
    "recallObligations": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "kind", "obligation"],
        "properties": {
          "sourceId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "kind": {
            "type": "string",
            "enum": ["causal", "character_knowledge", "timeline", "promise", "foreshadowing", "world_rule", "other"]
          },
          "obligation": { "type": "string", "minLength": 8, "maxLength": 260 }
        }
      }
    },
    "characterPressure": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["characterId", "currentGoal", "pressure", "choiceCost", "knowledgeBoundary"],
        "properties": {
          "characterId": { "type": "string", "minLength": 1, "maxLength": 120 },
          "currentGoal": { "type": "string", "minLength": 4, "maxLength": 220 },
          "pressure": { "type": "string", "minLength": 4, "maxLength": 220 },
          "choiceCost": { "type": "string", "minLength": 4, "maxLength": 220 },
          "knowledgeBoundary": { "type": "string", "minLength": 4, "maxLength": 260 }
        }
      }
    },
    "repetitionAvoidance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 4, "maxLength": 220 }
    },
    "sensoryAnchors": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": { "type": "string", "minLength": 2, "maxLength": 120 }
    },
    "endingObligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arrivingConsequence", "unresolvedPressure", "forbiddenShortcut"],
      "properties": {
        "arrivingConsequence": { "type": "string", "minLength": 8, "maxLength": 240 },
        "unresolvedPressure": { "type": "string", "minLength": 8, "maxLength": 240 },
        "forbiddenShortcut": { "type": "string", "minLength": 8, "maxLength": 240 }
      }
    }
  }
}
