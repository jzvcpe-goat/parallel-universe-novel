{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "question",
    "options",
    "requiresAuthorSelection",
    "writerInvoked",
    "canonCommitAllowed"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "creator-scene-author-decision-options.v1"
    },
    "question": { "type": "string", "minLength": 12, "maxLength": 180 },
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "primaryChangedAxis",
          "proposedAdjustment",
          "preservedAuthorIntent",
          "addressesIssueCodes",
          "whyItBreaksRepetition",
          "expectedMechanismSignature",
          "tradeoff"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 3, "maxLength": 80 },
          "label": { "type": "string", "minLength": 4, "maxLength": 40 },
          "primaryChangedAxis": {
            "type": "string",
            "enum": ["pressureSource", "conflictEngine", "agencyPattern", "costPattern", "endingPattern"]
          },
          "proposedAdjustment": { "type": "string", "minLength": 16, "maxLength": 360 },
          "preservedAuthorIntent": {
            "type": "array",
            "minItems": 2,
            "maxItems": 6,
            "items": { "type": "string", "minLength": 4, "maxLength": 180 }
          },
          "addressesIssueCodes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "string",
              "enum": ["signature_mismatch", "superficial_difference", "causal_chain_repetition", "ending_repetition"]
            }
          },
          "whyItBreaksRepetition": { "type": "string", "minLength": 16, "maxLength": 360 },
          "expectedMechanismSignature": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pressureSource", "conflictEngine", "agencyPattern", "costPattern", "endingPattern"],
            "properties": {
              "pressureSource": { "type": "string", "enum": ["environment", "opponent", "institution", "relationship", "body", "time", "resource", "information"] },
              "conflictEngine": { "type": "string", "enum": ["rescue", "pursuit", "negotiation", "infiltration", "escape", "investigation", "combat", "survival", "sacrifice", "revelation"] },
              "agencyPattern": { "type": "string", "enum": ["command", "refusal", "concealment", "sacrifice", "bargain", "delegation", "improvisation", "endurance", "pursuit", "withdrawal"] },
              "costPattern": { "type": "string", "enum": ["evidence_loss", "injury", "trust_loss", "resource_loss", "time_loss", "exposure", "position_loss", "obligation", "opportunity_loss", "separation"] },
              "endingPattern": { "type": "string", "enum": ["consequence_arrives", "irreversible_loss", "relationship_shift", "opponent_gain", "location_shift", "promise_advanced", "question_opened", "temporary_relief", "capability_change"] }
            }
          },
          "tradeoff": { "type": "string", "minLength": 12, "maxLength": 260 }
        }
      }
    },
    "requiresAuthorSelection": { "type": "boolean", "const": true },
    "writerInvoked": { "type": "boolean", "const": false },
    "canonCommitAllowed": { "type": "boolean", "const": false }
  }
}
