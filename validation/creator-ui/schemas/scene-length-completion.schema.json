{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "appendText"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "creator-scene-length-completion.v1"
    },
    "appendText": {
      "type": "string",
      "minLength": 80,
      "maxLength": 900,
      "pattern": "[。！？!?…][”’」』）》）\\]\\}]*\\s*$",
      "description": "One append-only continuation for the current scene. Runtime validation enforces the request-specific visible-character deficit."
    }
  }
}
