{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Creator Character Simulation Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "simulationRunId",
    "decision",
    "verifiedCharacterProposalIndexes",
    "verifiedSettingProposalIndexes",
    "issues",
    "rationale"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "creator-character-simulation-review.v1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "simulationRunId": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "type": "string",
      "enum": ["pass", "reject"]
    },
    "verifiedCharacterProposalIndexes": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 15
      }
    },
    "verifiedSettingProposalIndexes": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 11
      }
    },
    "issues": {
      "type": "array",
      "maxItems": 28,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "proposalKind",
          "proposalIndex",
          "code",
          "evidenceQuote",
          "diagnosis"
        ],
        "properties": {
          "proposalKind": {
            "type": "string",
            "enum": ["character", "setting"]
          },
          "proposalIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "code": {
            "type": "string",
            "enum": [
              "identity_scope",
              "evidence_overclaim",
              "state_dimension_semantics",
              "before_state_mismatch",
              "relationship_causality",
              "setting_scope",
              "canon_boundary",
              "confidence_overclaim"
            ]
          },
          "evidenceQuote": {
            "type": "string",
            "minLength": 2,
            "maxLength": 500
          },
          "diagnosis": {
            "type": "string",
            "minLength": 4,
            "maxLength": 320
          }
        }
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 4,
      "maxLength": 320
    }
  }
}
