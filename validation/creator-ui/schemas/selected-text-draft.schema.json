{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "body", "unplannedFactProposals", "stateProposals"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "creator-scene-draft.v1" },
    "body": {
      "type": "string",
      "minLength": 20,
      "maxLength": 2600,
      "pattern": "[。！？!?…][”’」』）》）\\]\\}]*\\s*$",
      "description": "A complete replacement for only the author-selected manuscript blocks. The application validates the request-specific visible-character range."
    },
    "unplannedFactProposals": {
      "type": "array",
      "maxItems": 4,
      "items": { "type": "string", "minLength": 2, "maxLength": 160 }
    },
    "stateProposals": {
      "type": "array",
      "maxItems": 0,
      "description": "Writer and Rewriter must return an empty array. The independent Observer owns evidence-grounded state extraction.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "value", "reason", "irreversible", "evidenceQuote"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/characters/[^/]+/(location|timePosition|physicalCondition|emotionalState|dominantDesire|immediateGoal|currentIntent|fear|woundTrigger|defenseStrategy|beliefs|falseBeliefs|knowledge|secrets|resources|capabilities|limitations|relationshipStances|trust|obligations|recentChoice|paidCost)$"
          },
          "value": { "type": "string", "minLength": 1, "maxLength": 240 },
          "reason": { "type": "string", "minLength": 4, "maxLength": 180 },
          "irreversible": { "type": "boolean" },
          "evidenceQuote": { "type": "string", "minLength": 2, "maxLength": 160 }
        }
      }
    }
  }
}
