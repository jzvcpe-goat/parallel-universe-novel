{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "decision", "checks", "rationale"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "creator-manual-recall-adherence-review.v1"
    },
    "decision": {
      "type": "string",
      "enum": ["pass", "reject"]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "group", "status", "evidenceQuotes", "diagnosis"],
        "properties": {
          "sourceId": { "type": "string", "minLength": 1 },
          "group": {
            "type": "string",
            "enum": ["causal", "character_knowledge", "timeline", "promise"]
          },
          "status": {
            "type": "string",
            "enum": ["fulfilled", "respected", "violated", "omitted"]
          },
          "evidenceQuotes": {
            "type": "array",
            "maxItems": 3,
            "items": { "type": "string", "minLength": 2, "maxLength": 180 }
          },
          "diagnosis": { "type": "string", "minLength": 8, "maxLength": 240 }
        }
      }
    },
    "rationale": { "type": "string", "minLength": 8, "maxLength": 320 }
  }
}
