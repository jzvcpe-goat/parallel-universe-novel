{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "windowStart", "windowEnd", "inspectedTransitions", "findings"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "creator-longform-continuity-review.v1" },
    "windowStart": { "type": "integer", "minimum": 1 },
    "windowEnd": { "type": "integer", "minimum": 1 },
    "inspectedTransitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fromChapter", "toChapter", "status", "findingIndexes"],
        "properties": {
          "fromChapter": { "type": "integer", "minimum": 1 },
          "toChapter": { "type": "integer", "minimum": 1 },
          "status": { "type": "string", "enum": ["pass", "needs_revision", "blocked"] },
          "findingIndexes": {
            "type": "array",
            "maxItems": 8,
            "items": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dimension",
          "severity",
          "fromChapter",
          "toChapter",
          "sourceEvidenceQuote",
          "targetEvidenceQuote",
          "expected",
          "observed",
          "readerImpact",
          "diagnosis",
          "repairTargetChapter",
          "repairDirection",
          "confidence"
        ],
        "properties": {
          "dimension": {
            "type": "string",
            "enum": [
              "causal_handoff",
              "knowledge_boundary",
              "timeline",
              "promise",
              "foreshadowing",
              "character_motivation",
              "setting_consistency",
              "repetition",
              "voice_drift"
            ]
          },
          "severity": { "type": "string", "enum": ["hard_block", "revision_candidate", "watch"] },
          "fromChapter": { "type": "integer", "minimum": 1 },
          "toChapter": { "type": "integer", "minimum": 1 },
          "sourceEvidenceQuote": { "type": "string", "minLength": 2, "maxLength": 180 },
          "targetEvidenceQuote": { "type": "string", "minLength": 2, "maxLength": 180 },
          "expected": { "type": "string", "minLength": 8, "maxLength": 240 },
          "observed": { "type": "string", "minLength": 8, "maxLength": 240 },
          "readerImpact": { "type": "string", "minLength": 8, "maxLength": 240 },
          "diagnosis": { "type": "string", "minLength": 8, "maxLength": 240 },
          "repairTargetChapter": { "type": "integer", "minimum": 1 },
          "repairDirection": { "type": "string", "minLength": 8, "maxLength": 240 },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] }
        }
      }
    }
  }
}
