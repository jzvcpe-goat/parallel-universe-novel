{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Creator Long-form Continuity Verification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "items", "rationale"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "creator-longform-continuity-verification.v1"
    },
    "items": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "findingIndex",
          "fromChapter",
          "toChapter",
          "decision",
          "confirmedSeverity",
          "sourceEvidenceQuote",
          "targetEvidenceQuote",
          "diagnosis"
        ],
        "properties": {
          "findingIndex": { "type": "integer", "minimum": 0 },
          "fromChapter": { "type": "integer", "minimum": 1 },
          "toChapter": { "type": "integer", "minimum": 1 },
          "decision": { "type": "string", "enum": ["verify", "reject"] },
          "confirmedSeverity": {
            "type": ["string", "null"],
            "enum": ["hard_block", "revision_candidate", "watch", null]
          },
          "sourceEvidenceQuote": { "type": "string", "minLength": 2, "maxLength": 180 },
          "targetEvidenceQuote": { "type": "string", "minLength": 2, "maxLength": 180 },
          "diagnosis": { "type": "string", "minLength": 8, "maxLength": 320 }
        }
      }
    },
    "rationale": { "type": "string", "minLength": 8, "maxLength": 320 }
  }
}
